# CartPilot API (Cloud Run). Copy to .env for local dev. Never commit .env.

# --- AI (any OpenAI-compatible chat-completions gateway; AI Lodge uses apiyi) ---
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key (AI Lodge key bot). Old name GEMINI_API_KEY still works.
API_KEY=
# Text model: recipes, ingredient list + method, match double-check, leftover ideas. Old name GEMINI_MODEL still works.
MODEL_NAME=deepseek-v4-1-flash-260910
# Vision model for the fridge-photo scan (deepseek-v4-1-flash-260910 reads images; deepseek-v4-flash ignored them).
VISION_MODEL_NAME=deepseek-v4-1-flash-260910

# true = canned AI answers, no model calls, no key needed (local development only). Must be false when deployed.
DEMO_MODE=false

# Only "mock" is supported: the 3 built-in fake stores (see README, "Why no real store?")
STORE_MODE=mock
# How many agents search at the same time in one run
MAX_PARALLEL=4

# Comma-separated browser origins allowed to call the API (the Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# --- AI Lodge rate limit (fallbacks; the central control sheet overrides them) ---
# Upstash keys come from the batch's shared env, not this file.
RATE_LIMIT_PLAN_MAX=12
RATE_LIMIT_SCAN_MAX=4
RATE_LIMIT_SEARCH_MAX=4
RATE_LIMIT_WINDOW_SECONDS=432000
